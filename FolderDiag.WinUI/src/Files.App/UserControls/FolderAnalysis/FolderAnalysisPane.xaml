<UserControl
    x:Class="Files.App.UserControls.FolderAnalysis.FolderAnalysisPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Files.App.ViewModels.FolderAnalysis"
    mc:Ignorable="d"
    MinWidth="320">

    <UserControl.Resources>
        <!-- Size bar style matching Files app theme colours -->
        <Style x:Key="SizeBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <Style x:Key="DriveBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </UserControl.Resources>

    <!-- Main layout -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header + scan controls -->
            <RowDefinition Height="Auto"/>   <!-- Summary chips -->
            <RowDefinition Height="*"/>      <!-- Content tabs -->
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="📊  Folder Analysis"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.ScanStatus, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Command="{x:Bind ViewModel.ScanCommand}"
                        IsEnabled="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                        Style="{StaticResource AccentButtonStyle}"
                        Margin="8,0,4,0" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE721;" FontSize="14"/>
                        <TextBlock Text="Scan"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Command="{x:Bind ViewModel.StopScanCommand}"
                        IsEnabled="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                        Padding="10,6">
                    <FontIcon Glyph="&#xE71A;" FontSize="14"/>
                </Button>
            </Grid>
        </Border>

        <!-- Scan progress bar (visible only while scanning) -->
        <ProgressBar Value="{x:Bind ViewModel.ScanProgress, Mode=OneWay}"
                     IsIndeterminate="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                     HorizontalAlignment="Stretch"
                     Height="3"
                     Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                     Margin="0"/>

        <!-- ═══ SUMMARY CHIPS ═══════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Padding="12,6">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <StackPanel>
                    <TextBlock Text="Total Size"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.TotalSizeLabel, Mode=OneWay}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                </StackPanel>
                <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4"/>
                <StackPanel>
                    <TextBlock Text="Files"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.FileCountLabel, Mode=OneWay}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                </StackPanel>
                <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4"/>
                <StackPanel>
                    <TextBlock Text="Folders"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.FolderCountLabel, Mode=OneWay}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                </StackPanel>
                <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4"/>
                <Button Command="{x:Bind ViewModel.SaveSnapshotCommand}"
                        Padding="8,4" ToolTipService.ToolTip="Save snapshot">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE722;" FontSize="13"/>
                        <TextBlock Text="Snapshot" FontSize="12"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ═══ CONTENT PIVOT ═══════════════════════════════════════════ -->
        <Pivot Grid.Row="2" Margin="0">

            <!-- ── FOLDER SIZES TAB ──────────────────────────────────── -->
            <PivotItem Header="Sizes">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Folder sizes list -->
                    <ListView Grid.Row="0"
                              ItemsSource="{x:Bind ViewModel.FolderSizes, Mode=OneWay}"
                              SelectionMode="Single"
                              IsItemClickEnabled="True">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:FolderSizeResult">
                                <Grid Padding="0,6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Name + size -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{x:Bind Name}"
                                                   Style="{StaticResource BodyTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind SizeFormatted}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                   Margin="8,0,0,0"/>
                                    </Grid>

                                    <!-- Progress bar (% of parent) -->
                                    <ProgressBar Grid.Row="1"
                                                 Value="{x:Bind PercentOfParent}"
                                                 Minimum="0" Maximum="100"
                                                 Height="6"
                                                 Margin="0,4,0,2"
                                                 CornerRadius="3"/>

                                    <!-- Stats row: % | files | folders | allocated -->
                                    <StackPanel Grid.Row="2"
                                                Orientation="Horizontal"
                                                Spacing="10">
                                        <TextBlock Text="{x:Bind PercentFormatted}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="·"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <FontIcon Glyph="&#xE8A5;" FontSize="11"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{x:Bind FileCountFormatted}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="·"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="11"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{x:Bind FolderCountFormatted}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="·"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock Text="{x:Bind AllocatedFormatted}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   ToolTipService.ToolTip="Allocated size (cluster-aligned)"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Chart strip (bar chart via ItemsRepeater + rectangles) -->
                    <Border Grid.Row="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="12,10"
                            MaxHeight="160">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Text="Distribution (top folders)"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,0,0,6"/>
                            <ItemsRepeater Grid.Row="1"
                                           ItemsSource="{x:Bind ViewModel.ChartSlices, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Vertical" Spacing="5"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChartSlice">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{x:Bind Label}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       VerticalAlignment="Center"/>
                                            <ProgressBar Grid.Column="1"
                                                         Value="{x:Bind Percent}"
                                                         Minimum="0" Maximum="100"
                                                         Height="8"
                                                         VerticalAlignment="Center"
                                                         CornerRadius="3"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{x:Bind PercentFormatted}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </Grid>
                    </Border>
                </Grid>
            </PivotItem>

            <!-- ── FILE REPORTS TAB ──────────────────────────────────── -->
            <PivotItem Header="Reports">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Report selector -->
                    <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  SelectedIndex="{x:Bind ViewModel.SelectedReportIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Largest Files"/>
                            <ComboBoxItem Content="Oldest Files"/>
                            <ComboBoxItem Content="Temp / Junk Files"/>
                            <ComboBoxItem Content="Duplicate Files"/>
                        </ComboBox>
                        <ComboBox Grid.Column="1"
                                  SelectedIndex="0"
                                  Width="90">
                            <ComboBoxItem Content="Top 25"/>
                            <ComboBoxItem Content="Top 50"/>
                            <ComboBoxItem Content="Top 100"/>
                        </ComboBox>
                        <Button Grid.Column="2"
                                Command="{x:Bind ViewModel.LoadReportCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="12,6">
                            <TextBlock Text="Run"/>
                        </Button>
                    </Grid>

                    <!-- Report results list -->
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.FileReports, Mode=OneWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:FileReportItem">
                                <Grid Padding="0,4" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Grid.Column="0"
                                              Glyph="&#xE8A5;"
                                              FontSize="18"
                                              VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}"
                                                   Style="{StaticResource BodyTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind FolderPath}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{x:Bind SizeFormatted}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock Text="{x:Bind Category}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <!-- ── DISK SPACE TAB ─────────────────────────────────────── -->
            <PivotItem Header="Disk">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" Padding="12,12,12,20">
                        <Button Command="{x:Bind ViewModel.LoadDriveSpacesCommand}"
                                HorizontalAlignment="Right" Padding="10,4">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                                <TextBlock Text="Refresh"/>
                            </StackPanel>
                        </Button>

                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.DriveSpaces, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="10"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:DriveSpaceItem">
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14,12">
                                        <StackPanel Spacing="8">

                                            <!-- Drive label -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0"
                                                          Glyph="&#xEDA2;"
                                                          FontSize="22"
                                                          Margin="0,0,10,0"
                                                          VerticalAlignment="Center"
                                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}">
                                                        <Run Text="{x:Bind Label}"/>
                                                        <Run Text=" ("/>
                                                        <Run Text="{x:Bind DriveName}"/>
                                                        <Run Text=")"/>
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                        <Run Text="{x:Bind FileSystem}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{x:Bind DriveType}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="{x:Bind UsedPercentFormatted}"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            </Grid>

                                            <!-- Disk usage progress bar -->
                                            <ProgressBar Value="{x:Bind UsedPercent}"
                                                         Minimum="0" Maximum="100"
                                                         Height="10"
                                                         CornerRadius="4"/>

                                            <!-- Used / Free / Total -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Used"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                    <TextBlock Text="{x:Bind UsedFormatted}"
                                                               Style="{StaticResource BodyTextBlockStyle}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                                    <TextBlock Text="Free"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                    <TextBlock Text="{x:Bind FreeFormatted}"
                                                               Style="{StaticResource BodyTextBlockStyle}"
                                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                    <TextBlock Text="Total"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                    <TextBlock Text="{x:Bind TotalFormatted}"
                                                               Style="{StaticResource BodyTextBlockStyle}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- ── CLASSIFICATION TAB ─────────────────────────────────── -->
            <PivotItem Header="Types">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0"
                            Command="{x:Bind ViewModel.LoadClassificationCommand}"
                            HorizontalAlignment="Right"
                            Margin="12,8" Padding="10,4">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE721;" FontSize="13"/>
                            <TextBlock Text="Classify"/>
                        </StackPanel>
                    </Button>

                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Classification, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TypeClassificationItem">
                                <Grid Padding="0,6" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <FontIcon Grid.Column="0" Grid.RowSpan="2"
                                              Glyph="{x:Bind CategoryIcon}"
                                              FontSize="20"
                                              VerticalAlignment="Center"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

                                    <Grid Grid.Column="1" Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{x:Bind Category}"
                                                   Style="{StaticResource BodyTextBlockStyle}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind TotalSizeFormatted}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    </Grid>

                                    <ProgressBar Grid.Column="1" Grid.Row="1"
                                                 Value="{x:Bind Percent}"
                                                 Minimum="0" Maximum="100"
                                                 Height="5"
                                                 Margin="0,4,0,0"
                                                 CornerRadius="3"/>

                                    <TextBlock Grid.Column="2" Grid.RowSpan="2"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Run Text="{x:Bind PercentFormatted}"/>
                                        <LineBreak/>
                                        <Run Text="{x:Bind Count}"/>
                                        <Run Text=" files"/>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <!-- ── SNAPSHOTS TAB ──────────────────────────────────────── -->
            <PivotItem Header="Snapshots">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0"
                            Command="{x:Bind ViewModel.SaveSnapshotCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Right"
                            Margin="12,8" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE722;" FontSize="13"/>
                            <TextBlock Text="Save Snapshot"/>
                        </StackPanel>
                    </Button>
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Snapshots, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ScanSnapshotEntry">
                                <Grid Padding="0,4" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyTextBlockStyle}"/>
                                        <TextBlock Text="{x:Bind SavedAtFormatted}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="{x:Bind TotalSizeFormatted}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

        </Pivot>
    </Grid>
</UserControl>
