<UserControl
    x:Class="Files.App.UserControls.FolderAnalysis.FolderAnalysisPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Files.App.ViewModels.FolderAnalysis"
    mc:Ignorable="d"
    MinWidth="320">

    <UserControl.Resources>
        <Style x:Key="SizeBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <Style x:Key="DriveBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style x:Key="FilterChipStyle" TargetType="ToggleButton">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Style" Value="{StaticResource CaptionTextBlockStyle}"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <DataTemplate x:Key="FolderRowTemplate" x:DataType="vm:FolderSizeResult">
            <Grid Padding="0,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Bind Name}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind SizeFormatted}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                               Margin="8,0,0,0"/>
                </Grid>
                <ProgressBar Grid.Row="1" Value="{x:Bind PercentOfParent}"
                             Minimum="0" Maximum="100" Height="6"
                             Margin="0,4,0,2" CornerRadius="3"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{x:Bind PercentFormatted}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="·" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="{x:Bind FileCountFormatted}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="·" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="{x:Bind FolderCountFormatted}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="·" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="{x:Bind AllocatedFormatted}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               ToolTipService.ToolTip="Allocated size on disk"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="FileReportRowTemplate" x:DataType="vm:FileReportItem">
            <Grid Padding="0,4" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE8A5;" FontSize="18"
                          VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{x:Bind FolderPath}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{x:Bind SizeFormatted}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                               HorizontalAlignment="Right"/>
                    <TextBlock Text="{x:Bind ModifiedFormatted}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ══════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="📊  Folder Analysis"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.ScanStatus, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{x:Bind ViewModel.ScanCommand}"
                        IsEnabled="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                        Style="{StaticResource AccentButtonStyle}"
                        Margin="8,0,4,0" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE721;" FontSize="14"/>
                        <TextBlock Text="Scan"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2"
                        Command="{x:Bind ViewModel.StopScanCommand}"
                        IsEnabled="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                        Padding="10,6">
                    <FontIcon Glyph="&#xE71A;" FontSize="14"/>
                </Button>
            </Grid>
        </Border>

        <!-- Scan progress bar -->
        <ProgressBar Value="{x:Bind ViewModel.ScanProgress, Mode=OneWay}"
                     IsIndeterminate="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                     HorizontalAlignment="Stretch"
                     Height="3"
                     Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                     Margin="0"/>

        <!-- ═══ SUMMARY CHIPS ════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Padding="12,6">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <StackPanel>
                    <TextBlock Text="Total Size" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.TotalSizeLabel, Mode=OneWay}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                </StackPanel>
                <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4"/>
                <StackPanel>
                    <TextBlock Text="Files" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.FileCountLabel, Mode=OneWay}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                </StackPanel>
                <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4"/>
                <StackPanel>
                    <TextBlock Text="Folders" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.FolderCountLabel, Mode=OneWay}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                </StackPanel>
                <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4"/>
                <Button Command="{x:Bind ViewModel.SaveSnapshotCommand}" Padding="8,4"
                        ToolTipService.ToolTip="Save snapshot for trend analysis">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE722;" FontSize="13"/>
                        <TextBlock Text="Snapshot" FontSize="12"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ═══ CONTENT PIVOT (8 tabs) ═══════════════════════════════════ -->
        <Pivot Grid.Row="2" Margin="0">

            <!-- ── 1. SIZES ──────────────────────────────────────────────── -->
            <PivotItem Header="Sizes">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListView Grid.Row="0"
                              ItemsSource="{x:Bind ViewModel.FolderSizes, Mode=OneWay}"
                              ItemTemplate="{StaticResource FolderRowTemplate}"
                              SelectionMode="Single"
                              IsItemClickEnabled="True"/>
                    <!-- bar chart strip at the bottom -->
                    <Border Grid.Row="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="12,10"
                            MaxHeight="160">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Text="Relative size distribution"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,0,0,6"/>
                            <ItemsRepeater Grid.Row="1" ItemsSource="{x:Bind ViewModel.ChartSlices, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Vertical" Spacing="5"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChartSlice">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind Label}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       VerticalAlignment="Center"/>
                                            <ProgressBar Grid.Column="1" Value="{x:Bind Percent}"
                                                         Minimum="0" Maximum="100"
                                                         Height="8" VerticalAlignment="Center"
                                                         CornerRadius="3"/>
                                            <TextBlock Grid.Column="2" Text="{x:Bind PercentFormatted}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </Grid>
                    </Border>
                </Grid>
            </PivotItem>

            <!-- ── 2. CHARTS ─────────────────────────────────────────────── -->
            <PivotItem Header="Charts">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8" Padding="12,10,12,20">

                        <!-- Treemap: coloured boxes proportional to folder size -->
                        <TextBlock Text="Treemap" Style="{StaticResource SectionLabelStyle}"/>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8"
                                Height="200" ClipToBounds="True">
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.TreemapNodes, Mode=OneWay}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="80" MinItemHeight="80"
                                                       MinColumnSpacing="2" MinRowSpacing="2"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TreemapNode">
                                        <Border Background="{x:Bind ColorBrush}"
                                                CornerRadius="4"
                                                ToolTipService.ToolTip="{x:Bind Tooltip}">
                                            <StackPanel Padding="8,6" VerticalAlignment="Bottom">
                                                <TextBlock Text="{x:Bind Label}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="White"/>
                                                <TextBlock Text="{x:Bind SizeFormatted}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="rgba(255,255,255,0.7)"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </Border>

                        <!-- Pie chart: type slices (data-bound segments via ItemsRepeater as legend) -->
                        <TextBlock Text="File type breakdown" Style="{StaticResource SectionLabelStyle}"/>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.PieSlices, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="6"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChartSlice">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="52"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                            <Border Width="10" Height="10" CornerRadius="2"
                                                    Background="{x:Bind ColorBrush}"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind Label}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ProgressBar Grid.Column="1" Value="{x:Bind Percent}"
                                                     Minimum="0" Maximum="100"
                                                     Height="8" VerticalAlignment="Center"
                                                     CornerRadius="3"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind SizeFormatted}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{x:Bind PercentFormatted}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <!-- Depth distribution bar chart -->
                        <TextBlock Text="Size by folder depth" Style="{StaticResource SectionLabelStyle}"/>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.DepthReport, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="6"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:FileDepthItem">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="52"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind DepthLabel}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <ProgressBar Grid.Column="1" Value="{x:Bind SizePercent}"
                                                     Minimum="0" Maximum="100"
                                                     Height="18" VerticalAlignment="Center"
                                                     CornerRadius="3"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind SizeFormatted}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{x:Bind CountFormatted}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- ── 3. REPORTS ────────────────────────────────────────────── -->
            <PivotItem Header="Reports">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Report type selector + run -->
                    <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  SelectedIndex="{x:Bind ViewModel.SelectedReportIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Largest Files"/>
                            <ComboBoxItem Content="Oldest Files"/>
                            <ComboBoxItem Content="Newest Files"/>
                            <ComboBoxItem Content="Temp / Junk Files"/>
                            <ComboBoxItem Content="Duplicate Files"/>
                            <ComboBoxItem Content="By Owner"/>
                            <ComboBoxItem Content="File Attributes"/>
                        </ComboBox>
                        <ComboBox Grid.Column="1" SelectedIndex="0" Width="90">
                            <ComboBoxItem Content="Top 25"/>
                            <ComboBoxItem Content="Top 50"/>
                            <ComboBoxItem Content="Top 100"/>
                        </ComboBox>
                        <Button Grid.Column="2"
                                Command="{x:Bind ViewModel.LoadReportCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="12,6">
                            <TextBlock Text="Run"/>
                        </Button>
                    </Grid>

                    <!-- Summary row -->
                    <Border Grid.Row="1"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            Padding="12,4">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{x:Bind ViewModel.ReportSummary, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Results list -->
                    <ListView Grid.Row="2"
                              ItemsSource="{x:Bind ViewModel.FileReports, Mode=OneWay}"
                              ItemTemplate="{StaticResource FileReportRowTemplate}"
                              SelectionMode="Single"/>

                    <!-- Export toolbar -->
                    <Border Grid.Row="3"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.ExportFileReportCommand}"
                                    CommandParameter="Csv" Padding="10,5">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE8F4;" FontSize="13"/>
                                    <TextBlock Text="CSV" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.ExportFileReportCommand}"
                                    CommandParameter="Xml" Padding="10,5">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE8F4;" FontSize="13"/>
                                    <TextBlock Text="XML" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.ExportFileReportCommand}"
                                    CommandParameter="Html" Padding="10,5">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE8F4;" FontSize="13"/>
                                    <TextBlock Text="HTML" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </PivotItem>

            <!-- ── 4. DISTRIBUTION ───────────────────────────────────────── -->
            <PivotItem Header="Distrib.">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Sub-report selector -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Padding="12,8">
                        <ToggleButton Content="By Age"
                                      IsChecked="{x:Bind ViewModel.DistribByAge, Mode=TwoWay}"
                                      Style="{StaticResource FilterChipStyle}"
                                      Command="{x:Bind ViewModel.LoadDistributionCommand}"
                                      CommandParameter="age"/>
                        <ToggleButton Content="By Depth"
                                      IsChecked="{x:Bind ViewModel.DistribByDepth, Mode=TwoWay}"
                                      Style="{StaticResource FilterChipStyle}"
                                      Command="{x:Bind ViewModel.LoadDistributionCommand}"
                                      CommandParameter="depth"/>
                        <ToggleButton Content="By Size"
                                      IsChecked="{x:Bind ViewModel.DistribBySize, Mode=TwoWay}"
                                      Style="{StaticResource FilterChipStyle}"
                                      Command="{x:Bind ViewModel.LoadDistributionCommand}"
                                      CommandParameter="size"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="12,0,12,20" Spacing="0">

                            <!-- Age distribution -->
                            <TextBlock Text="File age distribution"
                                       Style="{StaticResource SectionLabelStyle}"
                                       Visibility="{x:Bind ViewModel.DistribByAge, Mode=OneWay}"/>
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.AgeDistribution, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.DistribByAge, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Vertical" Spacing="6"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FileAgeGroupItem">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="82"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="44"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind Label}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <ProgressBar Grid.Column="1" Value="{x:Bind CountPercent}"
                                                         Minimum="0" Maximum="100"
                                                         Height="20" VerticalAlignment="Center"
                                                         CornerRadius="3"/>
                                            <TextBlock Grid.Column="2" Text="{x:Bind SizeFormatted}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{x:Bind CountFormatted}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <!-- Size distribution -->
                            <TextBlock Text="File size distribution"
                                       Style="{StaticResource SectionLabelStyle}"
                                       Visibility="{x:Bind ViewModel.DistribBySize, Mode=OneWay}"/>
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.SizeDistribution, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.DistribBySize, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Vertical" Spacing="6"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FileSizeGroupItem">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="82"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="44"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind RangeLabel}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <ProgressBar Grid.Column="1" Value="{x:Bind CountPercent}"
                                                         Minimum="0" Maximum="100"
                                                         Height="20" VerticalAlignment="Center"
                                                         CornerRadius="3"/>
                                            <TextBlock Grid.Column="2" Text="{x:Bind TotalSizeFormatted}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{x:Bind CountFormatted}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <!-- Depth distribution -->
                            <TextBlock Text="File depth distribution"
                                       Style="{StaticResource SectionLabelStyle}"
                                       Visibility="{x:Bind ViewModel.DistribByDepth, Mode=OneWay}"/>
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.DepthReport, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.DistribByDepth, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Vertical" Spacing="6"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FileDepthItem">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="52"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind DepthLabel}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <ProgressBar Grid.Column="1" Value="{x:Bind SizePercent}"
                                                         Minimum="0" Maximum="100"
                                                         Height="20" VerticalAlignment="Center"
                                                         CornerRadius="3"/>
                                            <TextBlock Grid.Column="2" Text="{x:Bind SizeFormatted}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{x:Bind CountFormatted}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </PivotItem>

            <!-- ── 5. DISK ────────────────────────────────────────────────── -->
            <PivotItem Header="Disk">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" Padding="12,12,12,20">
                        <Button Command="{x:Bind ViewModel.LoadDriveSpacesCommand}"
                                HorizontalAlignment="Right" Padding="10,4">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                                <TextBlock Text="Refresh"/>
                            </StackPanel>
                        </Button>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.DriveSpaces, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="10"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:DriveSpaceItem">
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="8"
                                            Padding="14,12">
                                        <StackPanel Spacing="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0" Glyph="&#xEDA2;"
                                                          FontSize="22" Margin="0,0,10,0"
                                                          VerticalAlignment="Center"
                                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}">
                                                        <Run Text="{x:Bind Label}"/>
                                                        <Run Text=" ("/>
                                                        <Run Text="{x:Bind DriveName}"/>
                                                        <Run Text=")"/>
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                        <Run Text="{x:Bind FileSystem}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{x:Bind DriveType}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="{x:Bind UsedPercentFormatted}"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            </Grid>
                                            <ProgressBar Value="{x:Bind UsedPercent}"
                                                         Minimum="0" Maximum="100"
                                                         Height="10" CornerRadius="4"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Used"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                    <TextBlock Text="{x:Bind UsedFormatted}"
                                                               Style="{StaticResource BodyTextBlockStyle}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                                    <TextBlock Text="Free"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                    <TextBlock Text="{x:Bind FreeFormatted}"
                                                               Style="{StaticResource BodyTextBlockStyle}"
                                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                    <TextBlock Text="Total"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                    <TextBlock Text="{x:Bind TotalFormatted}"
                                                               Style="{StaticResource BodyTextBlockStyle}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- ── 6. SEARCH ─────────────────────────────────────────────── -->
            <PivotItem Header="Search">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Search bar -->
                    <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}"
                                 PlaceholderText="Name pattern, e.g. *.zip"
                                 KeyboardAcceleratorPlacementMode="Hidden"/>
                        <Button Grid.Column="1"
                                Command="{x:Bind ViewModel.SearchFilesCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="12,6">
                            <FontIcon Glyph="&#xE721;" FontSize="14"/>
                        </Button>
                    </Grid>

                    <!-- Filter chips -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Padding="12,0,12,8">
                        <ToggleButton Content="Min 10 MB"
                                      IsChecked="{x:Bind ViewModel.SearchFilterMinSize, Mode=TwoWay}"
                                      Style="{StaticResource FilterChipStyle}"/>
                        <ToggleButton Content="Last 90 days"
                                      IsChecked="{x:Bind ViewModel.SearchFilterRecent, Mode=TwoWay}"
                                      Style="{StaticResource FilterChipStyle}"/>
                        <ToggleButton Content="Hidden"
                                      IsChecked="{x:Bind ViewModel.SearchFilterHidden, Mode=TwoWay}"
                                      Style="{StaticResource FilterChipStyle}"/>
                        <ToggleButton Content="Read-only"
                                      IsChecked="{x:Bind ViewModel.SearchFilterReadOnly, Mode=TwoWay}"
                                      Style="{StaticResource FilterChipStyle}"/>
                    </StackPanel>

                    <!-- Search results -->
                    <ListView Grid.Row="2"
                              ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}"
                              ItemTemplate="{StaticResource FileReportRowTemplate}"
                              SelectionMode="Multiple"/>

                    <!-- Export -->
                    <Border Grid.Row="3"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.SearchResultSummary, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <Button Command="{x:Bind ViewModel.ExportFileReportCommand}"
                                    CommandParameter="Csv" Padding="10,5">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE8F4;" FontSize="13"/>
                                    <TextBlock Text="Export CSV" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </PivotItem>

            <!-- ── 7. TREND ──────────────────────────────────────────────── -->
            <PivotItem Header="Trend">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Growth summary chips -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12"
                                Padding="12,8">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="10,6">
                            <StackPanel>
                                <TextBlock Text="Growth"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.TrendGrowthLabel, Mode=OneWay}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="10,6">
                            <StackPanel>
                                <TextBlock Text="Avg / month"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.TrendAvgMonthLabel, Mode=OneWay}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="10,6">
                            <StackPanel>
                                <TextBlock Text="Data points"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.TrendPointCount, Mode=OneWay}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Trend data points list -->
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.TrendPoints, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TrendPoint">
                                <Grid Padding="0,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Bind DateFormatted}"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind SizeFormatted}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind FileCountFormatted}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3"
                                               Text="{x:Bind DeltaFormatted}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Add snapshot + export -->
                    <Border Grid.Row="2"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.AddTrendPointCommand}"
                                    Style="{StaticResource AccentButtonStyle}" Padding="10,5">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE710;" FontSize="13"/>
                                    <TextBlock Text="Add Point" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.ExportFileReportCommand}"
                                    CommandParameter="Csv" Padding="10,5">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE8F4;" FontSize="13"/>
                                    <TextBlock Text="Export" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.ClearTrendCommand}"
                                    Padding="10,5">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                                    <TextBlock Text="Clear" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </PivotItem>

            <!-- ── 8. SNAPSHOTS ──────────────────────────────────────────── -->
            <PivotItem Header="Snapshots">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Snapshot controls -->
                    <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Saved scan snapshots"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Command="{x:Bind ViewModel.SaveSnapshotCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="12,6">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE722;" FontSize="13"/>
                                <TextBlock Text="Save" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Snapshot list -->
                    <ListView Grid.Row="1"
                              MaxHeight="180"
                              ItemsSource="{x:Bind ViewModel.Snapshots, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedSnapshot, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ScanSnapshotEntry">
                                <Grid Padding="0,4" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Bind Name}"
                                                   Style="{StaticResource BodyTextBlockStyle}"/>
                                        <TextBlock Text="{x:Bind SavedAtFormatted}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="{x:Bind TotalSizeFormatted}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{x:Bind FileCountFormatted}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Diff view -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                Padding="12,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Snapshot diff"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Command="{x:Bind ViewModel.CompareSnapshotsCommand}"
                                        Padding="10,4">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE8AD;" FontSize="13"/>
                                        <TextBlock Text="Compare" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                        <ListView Grid.Row="1"
                                  ItemsSource="{x:Bind ViewModel.DiffItems, Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SnapshotDiffItem">
                                    <Grid Padding="0,4" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{x:Bind FolderName}"
                                                   Style="{StaticResource BodyTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind DeltaSizeFormatted}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind DeltaPercentFormatted}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- Export toolbar -->
                    <Border Grid.Row="3"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.ExportFolderSizesCommand}"
                                    CommandParameter="Csv" Padding="10,5">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE8F4;" FontSize="13"/>
                                    <TextBlock Text="CSV" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.ExportFolderSizesCommand}"
                                    CommandParameter="Xml" Padding="10,5">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE8F4;" FontSize="13"/>
                                    <TextBlock Text="XML" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.ExportFolderSizesCommand}"
                                    CommandParameter="Html"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Padding="10,5">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE8F4;" FontSize="13"/>
                                    <TextBlock Text="HTML Report" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </PivotItem>

        </Pivot>
    </Grid>
</UserControl>
