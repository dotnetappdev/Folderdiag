<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Win11 Dark Theme Colors -->
    <Color x:Key="BackgroundDeepColor">#FF1C1C1C</Color>
    <Color x:Key="BackgroundColor">#FF202020</Color>
    <Color x:Key="BackgroundElevated1Color">#FF2C2C2C</Color>
    <Color x:Key="BackgroundElevated2Color">#FF383838</Color>
    <Color x:Key="BackgroundElevated3Color">#FF404040</Color>

    <Color x:Key="SurfaceColor">#FF262626</Color>
    <Color x:Key="SurfaceHoverColor">#FF323232</Color>
    <Color x:Key="SurfaceSelectedColor">#FF0078D4</Color>
    <Color x:Key="SurfaceSelectedHoverColor">#FF1A86D9</Color>

    <Color x:Key="BorderColor">#FF3D3D3D</Color>
    <Color x:Key="BorderSubtleColor">#FF2D2D2D</Color>

    <Color x:Key="TextPrimaryColor">#FFFFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#FFB4B4B4</Color>
    <Color x:Key="TextDisabledColor">#FF727272</Color>
    <Color x:Key="TextAccentColor">#FF60CDFF</Color>

    <Color x:Key="AccentColor">#FF0078D4</Color>
    <Color x:Key="AccentLightColor">#FF60CDFF</Color>
    <Color x:Key="AccentDarkColor">#FF005A9E</Color>

    <Color x:Key="GreenColor">#FF4CAF50</Color>
    <Color x:Key="OrangeColor">#FFFF9800</Color>
    <Color x:Key="RedColor">#FFF44336</Color>
    <Color x:Key="YellowColor">#FFFFEB3B</Color>

    <!-- Size bar gradient colors (like FolderSizes) -->
    <Color x:Key="SizeBarColor1">#FF0078D4</Color>
    <Color x:Key="SizeBarColor2">#FF00B4D8</Color>
    <Color x:Key="SizeBarColor3">#FF06D6A0</Color>
    <Color x:Key="SizeBarColor4">#FFFFD166</Color>
    <Color x:Key="SizeBarColor5">#FFEF476F</Color>
    <Color x:Key="SizeBarColor6">#FF9B5DE5</Color>
    <Color x:Key="SizeBarColor7">#FFFF6B6B</Color>
    <Color x:Key="SizeBarColor8">#FF4ECDC4</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundDeepBrush" Color="{StaticResource BackgroundDeepColor}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="BackgroundElevated1Brush" Color="{StaticResource BackgroundElevated1Color}"/>
    <SolidColorBrush x:Key="BackgroundElevated2Brush" Color="{StaticResource BackgroundElevated2Color}"/>
    <SolidColorBrush x:Key="BackgroundElevated3Brush" Color="{StaticResource BackgroundElevated3Color}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="{StaticResource SurfaceSelectedColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}"/>
    <SolidColorBrush x:Key="TextAccentBrush" Color="{StaticResource TextAccentColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}"/>
    <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource GreenColor}"/>
    <SolidColorBrush x:Key="OrangeBrush" Color="{StaticResource OrangeColor}"/>
    <SolidColorBrush x:Key="RedBrush" Color="{StaticResource RedColor}"/>

</ResourceDictionary>
