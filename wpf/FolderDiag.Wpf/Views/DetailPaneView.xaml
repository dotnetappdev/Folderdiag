<UserControl x:Class="FolderDiag.Wpf.Views.DetailPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:FolderDiag.Wpf.Converters"
             xmlns:models="clr-namespace:FolderDiag.Core.Models;assembly=FolderDiag.Core"
             Background="{StaticResource BackgroundElevated1Brush}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <conv:IsDirectoryToColorConverter x:Key="DirToColor"/>
        <conv:IsDirectoryToIconConverter x:Key="DirToIcon"/>

        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="InfoValueMono" TargetType="TextBlock" BasedOn="{StaticResource InfoValue}">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- Show message when nothing selected -->
        <Grid>
            <TextBlock Text="Select a file or folder to see details"
                       Foreground="{StaticResource TextDisabledBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="20">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Margin="16"
                        DataContext="{Binding}"
                        Visibility="{Binding Converter={StaticResource NullToVisibility}}">

                <!-- Icon + Name -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="{Binding IsDirectory, Converter={StaticResource DirToIcon}}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="32"
                               Foreground="{Binding IsDirectory, Converter={StaticResource DirToColor}}"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   MaxWidth="260"/>
                        <TextBlock Text="{Binding FileType}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding FileType}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                            <Setter Property="Text" Value="Folder"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <Separator/>

                <!-- Size info -->
                <Border Background="{StaticResource BackgroundElevated2Brush}"
                        CornerRadius="8"
                        Padding="12,10"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                   Style="{StaticResource InfoLabel}"
                                   Text="TOTAL SIZE"/>
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="{Binding TotalSizeFormatted}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentLightBrush}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}">
                            <Run Text="{Binding TotalSize, StringFormat=\{0:N0\}}"/>
                            <Run Text=" bytes"/>
                        </TextBlock>

                        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1"
                                Background="{StaticResource AccentBrush}"
                                CornerRadius="6"
                                Padding="8,4"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding PercentFormatted}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Folder-specific info -->
                <StackPanel Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVisibility}}">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource BackgroundElevated2Brush}"
                                CornerRadius="8" Padding="10,8" Margin="0,0,4,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource InfoLabel}" Text="FILES"/>
                                <TextBlock Text="{Binding FileCount, StringFormat=\{0:N0\}}"
                                           FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{StaticResource BackgroundElevated2Brush}"
                                CornerRadius="8" Padding="10,8" Margin="4,0,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource InfoLabel}" Text="FOLDERS"/>
                                <TextBlock Text="{Binding FolderCount, StringFormat=\{0:N0\}}"
                                           FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- File-specific info -->
                <StackPanel Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVisibility}}">
                    <!-- inverted for files -->
                </StackPanel>

                <!-- Path -->
                <TextBlock Style="{StaticResource InfoLabel}" Text="FULL PATH"/>
                <TextBlock Text="{Binding FullPath}"
                           Style="{StaticResource InfoValue}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           ToolTip="{Binding FullPath}"/>

                <!-- Dates -->
                <TextBlock Style="{StaticResource InfoLabel}" Text="LAST MODIFIED"/>
                <TextBlock Text="{Binding LastModified, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}"
                           Style="{StaticResource InfoValueMono}"/>

                <TextBlock Style="{StaticResource InfoLabel}" Text="CREATED"/>
                <TextBlock Text="{Binding Created, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}"
                           Style="{StaticResource InfoValueMono}"/>

                <!-- Own size (for folders) -->
                <StackPanel Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource InfoLabel}" Text="OWN SIZE (files directly in this folder)"/>
                    <TextBlock Text="{Binding OwnSizeFormatted}" Style="{StaticResource InfoValueMono}"/>
                </StackPanel>

                <!-- Extension info -->
                <StackPanel Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVisibility}}">
                    <!-- Invert visibility for files - show extension -->
                </StackPanel>

                <TextBlock Style="{StaticResource InfoLabel}"
                           Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVisibility}}"
                           Text="EXTENSION"/>
                <TextBlock Text="{Binding Extension}"
                           Style="{StaticResource InfoValueMono}"
                           Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVisibility}}"/>

                <!-- Attributes -->
                <TextBlock Style="{StaticResource InfoLabel}" Text="ATTRIBUTES" Margin="0,4,0,2"/>
                <WrapPanel Margin="0,0,0,8">
                    <Border Background="{StaticResource BackgroundElevated2Brush}"
                            CornerRadius="4" Padding="6,2" Margin="0,0,4,4"
                            Visibility="{Binding IsHidden, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Hidden" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>
                    <Border Background="{StaticResource BackgroundElevated2Brush}"
                            CornerRadius="4" Padding="6,2" Margin="0,0,4,4"
                            Visibility="{Binding IsSystem, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="System" FontSize="10" Foreground="{StaticResource OrangeBrush}"/>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
