<Window x:Class="FolderDiag.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FolderDiag.Wpf.ViewModels"
        xmlns:views="clr-namespace:FolderDiag.Wpf.Views"
        xmlns:ctrl="clr-namespace:FolderDiag.Wpf.Controls"
        xmlns:conv="clr-namespace:FolderDiag.Wpf.Converters"
        xmlns:models="clr-namespace:FolderDiag.Core.Models;assembly=FolderDiag.Core"
        Title="FolderDiag"
        Height="800" Width="1400"
        MinHeight="600" MinWidth="900"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
        <conv:FileSizeConverter x:Key="FileSize"/>
        <conv:IsDirectoryToIconConverter x:Key="DirToIcon"/>
        <conv:IsDirectoryToColorConverter x:Key="DirToColor"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <conv:PercentToColorConverter x:Key="PercentToColor"/>
        <conv:ExtensionToFileTypeConverter x:Key="ExtToIcon"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>   <!-- Toolbar -->
            <RowDefinition Height="40"/>   <!-- Search/Path bar -->
            <RowDefinition Height="*"/>    <!-- Main content -->
            <RowDefinition Height="28"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ===== TOOLBAR ===== -->
        <Border Grid.Row="0"
                Background="{StaticResource BackgroundElevated1Brush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False" Margin="8,0">
                <!-- App logo + title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,16,0">
                    <Border Width="32" Height="32" Background="{StaticResource AccentBrush}"
                            CornerRadius="8" Margin="0,0,8,0">
                        <TextBlock Text="FD" FontSize="13" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="FolderDiag" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Scan controls -->
                <Button DockPanel.Dock="Left" Style="{StaticResource AccentButton}"
                        Command="{Binding BrowseFolderCommand}"
                        Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Browse" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button DockPanel.Dock="Left" Style="{StaticResource ModernButton}"
                        Command="{Binding ScanCommand}"
                        CommandParameter="{Binding CurrentPath}"
                        IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}"
                        Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Scan" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button DockPanel.Dock="Left" Style="{StaticResource ModernButton}"
                        Command="{Binding CancelScanCommand}"
                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}"
                        Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Separator DockPanel.Dock="Left" Width="1" Height="28" Margin="4,0"/>

                <!-- View mode buttons -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="4,0">
                    <Button Style="{StaticResource IconButton}" ToolTip="Details view"
                            Command="{Binding SetViewModeCommand}"
                            CommandParameter="{x:Static models:ViewMode.Details}">
                        <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="Bar chart"
                            Command="{Binding SetViewModeCommand}"
                            CommandParameter="{x:Static models:ViewMode.BarChart}">
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="Treemap"
                            Command="{Binding SetViewModeCommand}"
                            CommandParameter="{x:Static models:ViewMode.Treemap}">
                        <TextBlock Text="&#xF246;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                    </Button>
                </StackPanel>

                <Separator DockPanel.Dock="Left" Width="1" Height="28" Margin="4,0"/>

                <!-- Navigation -->
                <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" ToolTip="Navigate up"
                        Command="{Binding NavigateUpCommand}" Margin="2,0">
                    <TextBlock Text="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>
                <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" ToolTip="Refresh"
                        Command="{Binding RefreshCommand}" Margin="2,0">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>
                <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" ToolTip="Open in Explorer"
                        Command="{Binding OpenInExplorerCommand}" Margin="2,0">
                    <TextBlock Text="&#xEC50;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>

                <Separator DockPanel.Dock="Left" Width="1" Height="28" Margin="4,0"/>

                <!-- Export -->
                <Button DockPanel.Dock="Left" Style="{StaticResource ModernButton}"
                        Command="{Binding ExportToCsvCommand}"
                        ToolTip="Export scan results to CSV"
                        Margin="2,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Export" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Settings (right) -->
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="Settings"
                        x:Name="SettingsButton" Margin="2,0"
                        Click="SettingsButton_Click">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>
            </DockPanel>
        </Border>

        <!-- ===== SEARCH / PATH BAR ===== -->
        <Border Grid.Row="1"
                Background="{StaticResource BackgroundBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="8,4">
                <!-- Back/Forward nav -->
                <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}"
                        Command="{Binding NavigateUpCommand}" ToolTip="Up"
                        Width="28" Height="28" Margin="0,0,4,0">
                    <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                </Button>

                <!-- Breadcrumb -->
                <ScrollViewer DockPanel.Dock="Left"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Width="320"
                              Margin="0,0,8,0">
                    <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconButton}"
                                            Width="Auto" Height="Auto"
                                            Padding="4,2"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            Cursor="Hand"
                                            ToolTip="{Binding Path}"
                                            Command="{Binding DataContext.ScanCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Path}">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextAccentBrush}"/>
                                    </Button>
                                    <TextBlock Text=" › " Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Search box (Windows 10/11 style) -->
                <Border DockPanel.Dock="Left"
                        Background="{StaticResource BackgroundElevated1Brush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="2,0"
                        MinWidth="280"
                        MaxWidth="500">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,4,0"/>

                        <TextBox Grid.Column="1"
                                 x:Name="SearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VerticalAlignment="Center"
                                 Padding="0,4"
                                 FontSize="13"
                                 KeyDown="SearchBox_KeyDown">
                        </TextBox>

                        <!-- Placeholder -->
                        <TextBlock Grid.Column="1"
                                   Text="Search files and folders..."
                                   Foreground="{StaticResource TextDisabledBrush}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="2,0"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={StaticResource NullToVisibility}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Clear button -->
                        <Button Grid.Column="2"
                                Style="{StaticResource IconButton}"
                                Width="24" Height="24"
                                Command="{Binding ClearSearchCommand}"
                                Visibility="{Binding IsSearchActive, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>

                        <!-- Filters button -->
                        <Button Grid.Column="3"
                                Style="{StaticResource IconButton}"
                                Width="28" Height="28"
                                ToolTip="Search filters"
                                Command="{Binding Search.ToggleAdvancedFiltersCommand}">
                            <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Summary stats -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="{Binding TotalSizeText}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextAccentBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding FileCountText}"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== MAIN CONTENT ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Left: Folder tree + drives -->
                <ColumnDefinition Width="{Binding Settings.TreePaneWidth, Mode=TwoWay}"
                                  MinWidth="160" MaxWidth="480"/>
                <ColumnDefinition Width="4"/>   <!-- Splitter -->
                <!-- Center: File list / chart -->
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="4"/>   <!-- Splitter -->
                <!-- Right: Detail/info panel -->
                <ColumnDefinition Width="{Binding Settings.DetailPaneWidth, Mode=TwoWay}"
                                  MinWidth="200" MaxWidth="480"/>
            </Grid.ColumnDefinitions>

            <!-- ---- LEFT PANE ---- -->
            <Grid Grid.Column="0" Background="{StaticResource BackgroundElevated1Brush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Drives section -->
                <Border Grid.Row="0" Padding="8,6" BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="DRIVES" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,6" LetterSpacing="1"/>
                        <ItemsControl ItemsSource="{Binding Drives}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DriveViewModel}">
                                    <Border Margin="0,1" Padding="6,4"
                                            CornerRadius="6" Cursor="Hand"
                                            Background="Transparent">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftDoubleClick"
                                                          Command="{Binding DataContext.ScanCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding RootPath}"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="&#xEDA2;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="18"
                                                       Foreground="{StaticResource TextAccentBrush}"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Label}" FontSize="12"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <ProgressBar Value="{Binding UsedPercent}"
                                                             Maximum="100" Height="3"
                                                             Margin="0,2,0,0">
                                                    <ProgressBar.Foreground>
                                                        <SolidColorBrush Color="{Binding UsedPercent, Converter={StaticResource PercentToColor}}"/>
                                                    </ProgressBar.Foreground>
                                                </ProgressBar>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding FreeSpaceText}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Folder tree -->
                <TreeView Grid.Row="1"
                          x:Name="FolderTree"
                          ItemsSource="{Binding FileTree.RootItems}"
                          SelectedItemChanged="FolderTree_SelectedItemChanged"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type models:FileSystemEntry}"
                                                  ItemsSource="{Binding Children}">
                            <Grid Margin="0,1" MinWidth="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Icon -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding IsDirectory, Converter={StaticResource DirToIcon}}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="{Binding IsDirectory, Converter={StaticResource DirToColor}}"
                                           Margin="0,0,5,0"
                                           VerticalAlignment="Center"/>
                                <!-- Name -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <!-- Size badge -->
                                <Border Grid.Column="2"
                                        Background="{StaticResource BackgroundElevated2Brush}"
                                        CornerRadius="3"
                                        Padding="4,1"
                                        Margin="4,0,0,0"
                                        Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding TotalSizeFormatted}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontFamily="{StaticResource MonoFont}"/>
                                </Border>
                            </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <!-- Recent paths -->
                <Expander Grid.Row="2"
                          Header="Recent Scans"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          FontSize="11">
                    <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RecentPaths}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource IconButton}"
                                            Width="Auto" Height="Auto"
                                            HorizontalContentAlignment="Left"
                                            Padding="8,4"
                                            Command="{Binding DataContext.ScanCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   ToolTip="{Binding}"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Expander>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderSubtleBrush}" Cursor="SizeWE"/>

            <!-- ---- CENTER PANE ---- -->
            <Grid Grid.Column="2">
                <!-- Search filter bar -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Advanced search filters -->
                <Border Grid.Row="0"
                        Background="{StaticResource BackgroundElevated1Brush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="0,0,0,1"
                        Visibility="{Binding Search.ShowAdvancedFilters, Converter={StaticResource BoolToVisibility}}"
                        Padding="12,8">
                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                            <TextBlock Text="Type:" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox ItemsSource="{Binding Search.TypeFilters}"
                                      SelectedItem="{Binding Search.SelectedTypeFilter}"
                                      Width="110" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                            <TextBlock Text="Size:" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox ItemsSource="{Binding Search.SizeFilters}"
                                      SelectedItem="{Binding Search.SelectedSizeFilter}"
                                      Width="140" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                            <TextBlock Text="Date:" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox ItemsSource="{Binding Search.DateFilters}"
                                      SelectedItem="{Binding Search.SelectedDateFilter}"
                                      Width="110" FontSize="11"/>
                        </StackPanel>
                        <CheckBox Content="Files" IsChecked="{Binding Search.IncludeFiles}"
                                  Margin="0,0,12,4" FontSize="11" VerticalAlignment="Center"/>
                        <CheckBox Content="Folders" IsChecked="{Binding Search.IncludeFolders}"
                                  Margin="0,0,12,4" FontSize="11" VerticalAlignment="Center"/>
                        <CheckBox Content="Match case" IsChecked="{Binding Search.MatchCase}"
                                  Margin="0,0,12,4" FontSize="11" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource ModernButton}"
                                Content="Clear Filters"
                                Command="{Binding Search.ClearFiltersCommand}"
                                Padding="8,3" FontSize="11"/>
                    </WrapPanel>
                </Border>

                <!-- Content area - Details/Chart/Treemap/Search -->
                <Grid Grid.Row="1">
                    <!-- Search results -->
                    <Grid Visibility="{Binding IsSearchActive, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource BackgroundElevated1Brush}"
                                Padding="12,6" BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="0,0,0,1">
                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="Search results: "/>
                                <Run Text="{Binding SearchResults.Count}" FontWeight="SemiBold"
                                     Foreground="{StaticResource TextAccentBrush}"/>
                                <Run Text=" matches"/>
                            </TextBlock>
                        </Border>
                        <ListView Grid.Row="1"
                                  ItemsSource="{Binding SearchResults}"
                                  SelectionMode="Extended"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Name" Width="280">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type models:FileSystemEntry}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Extension, Converter={StaticResource ExtToIcon}}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="13"
                                                               Foreground="{Binding IsDirectory, Converter={StaticResource DirToColor}}"
                                                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Path" Width="300"
                                                    DisplayMemberBinding="{Binding FullPath}"/>
                                    <GridViewColumn Header="Size" Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type models:FileSystemEntry}">
                                                <TextBlock Text="{Binding SizeFormatted}"
                                                           HorizontalAlignment="Right"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="11"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Modified" Width="140"
                                                    DisplayMemberBinding="{Binding LastModified, StringFormat=\{0:yyyy-MM-dd HH:mm\}}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>

                    <!-- Normal file list (Details view) -->
                    <Grid Visibility="{Binding IsSearchActive, Converter={StaticResource InverseBoolToVisibility}}">
                        <TabControl x:Name="MainTabControl"
                                    Background="{StaticResource BackgroundBrush}"
                                    BorderThickness="0">
                            <TabItem Header="Details">
                                <views:FileListView DataContext="{Binding}"/>
                            </TabItem>
                            <TabItem Header="Bar Chart">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Padding="12">
                                    <ctrl:BarChartControl x:Name="BarChart"
                                                          ItemsSource="{Binding CurrentItems}"
                                                          MaxItems="30"
                                                          MinHeight="400"/>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Treemap">
                                <ctrl:TreemapControl x:Name="Treemap"
                                                     RootEntry="{Binding CurrentDirectory}"
                                                     MaxDepth="2"/>
                            </TabItem>
                            <TabItem Header="History">
                                <views:ScanHistoryView DataContext="{Binding}"/>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderSubtleBrush}" Cursor="SizeWE"/>

            <!-- ---- RIGHT DETAIL PANE ---- -->
            <views:DetailPaneView Grid.Column="4"
                                  DataContext="{Binding SelectedEntry}"/>
        </Grid>

        <!-- ===== STATUS BAR ===== -->
        <Border Grid.Row="3"
                Background="{StaticResource AccentBrush}"
                Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Foreground="White"
                           FontSize="11"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Scan progress -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
                    <ProgressBar IsIndeterminate="True" Width="120" Height="4"
                                 Margin="0,0,8,0"
                                 Foreground="White"
                                 Background="#44FFFFFF"/>
                    <TextBlock Text="{Binding ScanProgressText}"
                               FontSize="10" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Item count -->
                <TextBlock Grid.Column="1"
                           Foreground="White" FontSize="11" VerticalAlignment="Center"
                           Visibility="{Binding IsScanning, Converter={StaticResource InverseBoolToVisibility}}">
                    <Run Text="{Binding CurrentItems.Count}"/>
                    <Run Text=" items"/>
                    <Run Text=" | "/>
                    <Run Text="{Binding SelectedCount}"/>
                    <Run Text=" selected"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
