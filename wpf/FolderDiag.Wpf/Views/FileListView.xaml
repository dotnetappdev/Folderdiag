<UserControl x:Class="FolderDiag.Wpf.Views.FileListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FolderDiag.Wpf.ViewModels"
             xmlns:models="clr-namespace:FolderDiag.Core.Models;assembly=FolderDiag.Core"
             xmlns:conv="clr-namespace:FolderDiag.Wpf.Converters"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:IsDirectoryToIconConverter x:Key="DirToIcon"/>
        <conv:IsDirectoryToColorConverter x:Key="DirToColor"/>
        <conv:ExtensionToFileTypeConverter x:Key="ExtToIcon"/>
        <conv:FileSizeConverter x:Key="FileSize"/>
        <conv:PercentToWidthConverter x:Key="PercentToWidth"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Column header sort buttons -->
        <Border Grid.Row="0"
                Background="{StaticResource BackgroundElevated1Brush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1">
            <Grid Height="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>     <!-- Icon -->
                    <ColumnDefinition Width="*"/>      <!-- Name -->
                    <ColumnDefinition Width="105"/>    <!-- Total Size -->
                    <ColumnDefinition Width="75"/>     <!-- % -->
                    <ColumnDefinition Width="200"/>    <!-- Size Bar -->
                    <ColumnDefinition Width="75"/>     <!-- Files -->
                    <ColumnDefinition Width="90"/>     <!-- Type -->
                    <ColumnDefinition Width="140"/>    <!-- Modified -->
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Style="{StaticResource IconButton}"
                        HorizontalContentAlignment="Left" Width="Auto" Height="Auto"
                        Padding="8,0"
                        Command="{Binding SortByCommand}" CommandParameter="{x:Static models:SortColumn.Name}">
                    <TextBlock Text="Name" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Button>

                <Button Grid.Column="2" Style="{StaticResource IconButton}"
                        HorizontalContentAlignment="Right" Width="Auto" Height="Auto"
                        Padding="8,0"
                        Command="{Binding SortByCommand}" CommandParameter="{x:Static models:SortColumn.TotalSize}">
                    <TextBlock Text="Total Size" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Button>

                <Button Grid.Column="3" Style="{StaticResource IconButton}"
                        HorizontalContentAlignment="Right" Width="Auto" Height="Auto"
                        Padding="8,0"
                        Command="{Binding SortByCommand}" CommandParameter="{x:Static models:SortColumn.Percent}">
                    <TextBlock Text="%" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Button>

                <TextBlock Grid.Column="4"
                           Text="Size Bar" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="8,0"/>

                <Button Grid.Column="5" Style="{StaticResource IconButton}"
                        HorizontalContentAlignment="Right" Width="Auto" Height="Auto"
                        Padding="8,0"
                        Command="{Binding SortByCommand}" CommandParameter="{x:Static models:SortColumn.FileCount}">
                    <TextBlock Text="Files" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Button>

                <TextBlock Grid.Column="6"
                           Text="Type" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="8,0"/>

                <Button Grid.Column="7" Style="{StaticResource IconButton}"
                        HorizontalContentAlignment="Left" Width="Auto" Height="Auto"
                        Padding="8,0"
                        Command="{Binding SortByCommand}" CommandParameter="{x:Static models:SortColumn.LastModified}">
                    <TextBlock Text="Modified" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Button>
            </Grid>
        </Border>

        <!-- File list -->
        <ListView Grid.Row="1"
                  x:Name="FileListView"
                  ItemsSource="{Binding CurrentItems}"
                  SelectionMode="Extended"
                  SelectionChanged="FileListView_SelectionChanged"
                  MouseDoubleClick="FileListView_DoubleClick"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Item"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListView.View>
                <GridView>
                    <!-- Icon column -->
                    <GridViewColumn Width="32">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:FileSystemEntry}">
                                <TextBlock Text="{Binding Extension, Converter={StaticResource ExtToIcon}}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Foreground="{Binding IsDirectory, Converter={StaticResource DirToColor}}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Name column -->
                    <GridViewColumn Width="180">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:FileSystemEntry}">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           ToolTip="{Binding FullPath}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Total Size -->
                    <GridViewColumn Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:FileSystemEntry}">
                                <TextBlock Text="{Binding TotalSizeFormatted}"
                                           HorizontalAlignment="Right"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Percent -->
                    <GridViewColumn Width="60">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:FileSystemEntry}">
                                <TextBlock Text="{Binding PercentFormatted}"
                                           HorizontalAlignment="Right"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Size Bar -->
                    <GridViewColumn Width="190">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:FileSystemEntry}">
                                <Grid Margin="2,0" Width="180" Height="14">
                                    <!-- Background track -->
                                    <Border Background="{StaticResource BackgroundElevated2Brush}"
                                            CornerRadius="3" HorizontalAlignment="Stretch"/>
                                    <!-- Fill bar - width bound to percent * 1.8 (max 180) -->
                                    <Border HorizontalAlignment="Left"
                                            CornerRadius="3"
                                            MinWidth="0"
                                            ClipToBounds="True">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource PercentToWidth}">
                                                <Binding Path="PercentOfParent"/>
                                                <Binding RelativeSource="{RelativeSource AncestorType=Grid}" Path="ActualWidth"/>
                                            </MultiBinding>
                                        </Border.Width>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#FF60CDFF" Offset="0"/>
                                                <GradientStop Color="#FF0078D4" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Files count -->
                    <GridViewColumn Width="70">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:FileSystemEntry}">
                                <TextBlock HorizontalAlignment="Right"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value=""/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                    <Setter Property="Text" Value="{Binding FileCount, StringFormat=\{0:N0\}}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Type -->
                    <GridViewColumn Width="90">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:FileSystemEntry}">
                                <TextBlock FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding FileType}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                    <Setter Property="Text" Value="Folder"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextAccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Modified -->
                    <GridViewColumn Width="140" DisplayMemberBinding="{Binding LastModified, StringFormat=\{0:yyyy-MM-dd HH:mm\}}"/>
                </GridView>
            </ListView.View>

            <!-- Context menu -->
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open in Explorer"
                              Command="{Binding DataContext.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding}">
                        <MenuItem.Icon>
                            <TextBlock Text="&#xEC50;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Navigate To"
                              Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding}">
                        <MenuItem.Icon>
                            <TextBlock Text="&#xE8B0;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Export to CSV..."
                              Command="{Binding DataContext.ExportToCsvCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Icon>
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Delete"
                              Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding}">
                        <MenuItem.Icon>
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </ListView.ContextMenu>
        </ListView>
    </Grid>
</UserControl>
