<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Lets the project restore/build on non-Windows CI agents too -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Per-monitor DPI awareness so "Use Windows display scaling" is exact on every monitor -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFO0003 is a WinForms-app analyzer; this is a WPF app (WinForms only for dialogs),
         and the manifest is the correct place for WPF DPI awareness. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>

    <!-- Product metadata (Version is overridden by CI with -p:Version=x.y.z) -->
    <Product>FolderDiag</Product>
    <Company>dotnetappdev</Company>
    <Description>FolderDiag - folder size analysis and file explorer</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FolderDiag.Core\FolderDiag.Core.csproj" />
    <ProjectReference Include="..\FolderDiag.Data\FolderDiag.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
  </ItemGroup>
  <!-- UseWindowsForms adds global usings for System.Windows.Forms / System.Drawing,
       which clash with WPF types (Application, Brush, ContextMenu, KeyEventArgs...).
       Remove them; WinForms types must be fully qualified in code. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
</Project>
