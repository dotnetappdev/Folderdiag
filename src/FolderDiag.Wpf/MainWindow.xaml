<Window x:Class="FolderDiag.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FolderDiag" Height="700" Width="1100">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button x:Name="BtnScan" Click="BtnScan_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/FolderDiag.Wpf;component/Icons/scan.png" Width="20" Height="20" Margin="0,0,6,0" />
                        <TextBlock>Scan</TextBlock>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnStop" Click="BtnStop_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/FolderDiag.Wpf;component/Icons/stop.png" Width="20" Height="20" Margin="0,0,6,0" />
                        <TextBlock>Stop</TextBlock>
                    </StackPanel>
                </Button>
                <Separator />
                <Button x:Name="BtnRefresh" Click="BtnRefresh_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/FolderDiag.Wpf;component/Icons/refresh.png" Width="20" Height="20" Margin="0,0,6,0" />
                        <TextBlock>Refresh</TextBlock>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnExport" Click="BtnExport_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/FolderDiag.Wpf;component/Icons/export.png" Width="20" Height="20" Margin="0,0,6,0" />
                        <TextBlock>Export</TextBlock>
                    </StackPanel>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom" x:Name="MainStatusBar">
            <StatusBarItem>
                <TextBlock x:Name="StatusTotal" Text="Ready" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Tree view of drives/folders -->
            <Border Grid.Column="0" BorderBrush="#DDD" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock Margin="8" FontWeight="Bold">Folders</TextBlock>
                    <TreeView x:Name="TreeFolders" SelectedItemChanged="TreeFolders_SelectedItemChanged" Margin="4" />
                </DockPanel>
            </Border>

            <!-- Splitter placeholder -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#EEE" />

            <!-- Right: main content -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="220" />
                </Grid.RowDefinitions>

                <!-- Top-right: Data grid -->
                <DataGrid x:Name="FoldersGrid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" />
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeBytes}" Width="160" />
                        <DataGridTextColumn Header="Scanned At" Binding="{Binding ScannedAt}" Width="200" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Bottom-right: chart / visualization placeholder -->
                <Border Grid.Row="1" Margin="8" BorderBrush="#CCC" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#666">Chart / Visualization Area</TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
