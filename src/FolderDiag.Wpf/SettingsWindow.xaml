<Window x:Class="FolderDiag.Wpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:FolderDiag.Wpf.Controls"
        Title="Settings — FolderDiag"
        Width="900" Height="660" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Win11BgBrush}"
        Foreground="{DynamicResource Win11TextBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="{DynamicResource Fs13}">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Win11PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Win11BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Fs20}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Fs14}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Win11SubTextBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource Fs12}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Category list ── -->
        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource Win11SidebarBrush}"
                BorderBrush="{DynamicResource Win11BorderBrush}" BorderThickness="0,0,1,0">
            <ListBox x:Name="NavList" Margin="6,10" SelectionChanged="NavList_SelectionChanged"
                     AutomationProperties.Name="Settings categories">
                <ListBoxItem Tag="Appearance" IsSelected="True">🎨   Appearance</ListBoxItem>
                <ListBoxItem Tag="Fonts">🔤   Fonts &amp; accessibility</ListBoxItem>
                <ListBoxItem Tag="Colours">📊   Bar colours</ListBoxItem>
                <ListBoxItem Tag="General">⚙   General</ListBoxItem>
            </ListBox>
        </Border>

        <ScrollViewer Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,18,24,6">
            <Grid>
                <!-- ═══════════ APPEARANCE ═══════════ -->
                <StackPanel x:Name="PageAppearance">
                    <TextBlock Text="Appearance" Style="{StaticResource PageTitle}"/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Theme" Style="{StaticResource CardTitle}"/>
                            <RadioButton x:Name="RbThemeSystem" GroupName="Theme" Checked="AnyChanged">
                                <TextBlock>
                                    <Run Text="Use Windows setting"/>
                                    <Run x:Name="RunWindowsMode" Foreground="{DynamicResource Win11SubTextBrush}"/>
                                </TextBlock>
                            </RadioButton>
                            <RadioButton x:Name="RbThemeLight" GroupName="Theme" Content="Light" Checked="AnyChanged"/>
                            <RadioButton x:Name="RbThemeDark"  GroupName="Theme" Content="Dark"  Checked="AnyChanged"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="'Use Windows setting' follows Settings › Personalisation › Colours › Choose your mode, and switches automatically when you change it."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Accent colour" Style="{StaticResource CardTitle}"/>
                            <CheckBox x:Name="ChkWindowsAccent" Content="Use my Windows accent colour"
                                      Checked="AnyChanged" Unchecked="AnyChanged"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Matches Settings › Personalisation › Colours › Accent colour. Untick to choose your own."/>
                            <ctl:SwatchPicker x:Name="AccentPicker" Label="Accent colour" SelectedColorChanged="AnyChanged"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Contrast" Style="{StaticResource CardTitle}"/>
                            <CheckBox x:Name="ChkHighContrast" Content="Follow Windows contrast themes"
                                      Checked="AnyChanged" Unchecked="AnyChanged"/>
                            <TextBlock x:Name="TxtContrastState" Style="{StaticResource Hint}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Preview" Style="{StaticResource CardTitle}"/>
                            <WrapPanel>
                                <Button Content="Button" Margin="0,0,8,8"/>
                                <Button Content="Accent button" Style="{StaticResource Win11AccentButtonStyle}" Margin="0,0,8,8"/>
                                <CheckBox Content="Checked" IsChecked="True" Margin="4,0,12,8"/>
                                <ComboBox Width="150" Margin="0,0,8,8" SelectedIndex="0">
                                    <ComboBoxItem Content="Drop-down"/>
                                    <ComboBoxItem Content="Second item"/>
                                </ComboBox>
                            </WrapPanel>
                            <Border Background="{DynamicResource Win11SelectBrush}" CornerRadius="4" Padding="10,6" Margin="0,4,0,4">
                                <TextBlock Text="📁  Selected row — Documents   12.4 GB"
                                           Foreground="{DynamicResource Win11SelectTextBrush}"/>
                            </Border>
                            <Border Padding="10,6">
                                <TextBlock Text="📁  Normal row — Downloads   3.1 GB"/>
                            </Border>
                            <TextBlock Text="Secondary text looks like this." Foreground="{DynamicResource Win11SubTextBrush}" Margin="10,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══════════ FONTS & ACCESSIBILITY ═══════════ -->
                <StackPanel x:Name="PageFonts" Visibility="Collapsed">
                    <TextBlock Text="Fonts &amp; accessibility" Style="{StaticResource PageTitle}"/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="UI scale" Style="{StaticResource CardTitle}"/>
                            <CheckBox x:Name="ChkWindowsScaling" Checked="AnyChanged" Unchecked="AnyChanged" Margin="0,0,0,8">
                                <TextBlock>
                                    <Run Text="Use Windows display scaling"/>
                                    <Run x:Name="RunWindowsScale" Foreground="{DynamicResource Win11SubTextBrush}"/>
                                </TextBlock>
                            </CheckBox>
                            <Grid x:Name="ScaleRow">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SldScale" Minimum="80" Maximum="200" TickFrequency="10"
                                        IsSnapToTickEnabled="True" SmallChange="10" LargeChange="10"
                                        ValueChanged="SliderChanged" VerticalAlignment="Center"
                                        AutomationProperties.Name="UI scale percent"/>
                                <TextBlock x:Name="TxtScale" Grid.Column="1" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <Button Grid.Column="2" Content="Reset" Margin="12,0,0,0" Click="BtnResetScale_Click"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="On: the app follows Settings › System › Display › Scale, per monitor. Off: zoom the whole window yourself, like Visual Studio — Ctrl + =  zoom in,  Ctrl + −  zoom out,  Ctrl + mouse wheel. Ctrl + 0 goes back to Windows scaling."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Environment font" Style="{StaticResource CardTitle}"/>
                            <CheckBox x:Name="ChkWindowsFont" Checked="AnyChanged" Unchecked="AnyChanged" Margin="0,0,0,4">
                                <TextBlock>
                                    <Run Text="Use Windows font"/>
                                    <Run x:Name="RunWindowsFont" Foreground="{DynamicResource Win11SubTextBrush}"/>
                                </TextBlock>
                            </CheckBox>
                            <CheckBox x:Name="ChkWindowsFontSize" Checked="AnyChanged" Unchecked="AnyChanged" Margin="0,4,0,10">
                                <TextBlock>
                                    <Run Text="Use Windows font size"/>
                                    <Run x:Name="RunWindowsTextSize" Foreground="{DynamicResource Win11SubTextBrush}"/>
                                </TextBlock>
                            </CheckBox>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Font" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CmbFont" Grid.Column="1" SelectionChanged="AnyChanged"
                                          AutomationProperties.Name="Font family">
                                    <ComboBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel/>
                                        </ItemsPanelTemplate>
                                    </ComboBox.ItemsPanel>
                                </ComboBox>
                                <TextBlock Grid.Column="2" Text="Size" Style="{StaticResource FieldLabel}" Margin="18,0,12,0"/>
                                <ComboBox x:Name="CmbFontSize" Grid.Column="3" SelectionChanged="AnyChanged"
                                          AutomationProperties.Name="Font size"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Untick a Windows option to choose your own font or size. Windows font size follows Settings › Accessibility › Text size and updates automatically."/>
                            <Border BorderBrush="{DynamicResource Win11BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="The quick brown fox jumps over the lazy dog. 0123456789"/>
                                    <TextBlock Text="Small text: 1,234 files · 56 folders · 7.8 GB"
                                               FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource Win11SubTextBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══════════ BAR COLOURS ═══════════ -->
                <StackPanel x:Name="PageColours" Visibility="Collapsed">
                    <TextBlock Text="Bar colours" Style="{StaticResource PageTitle}"/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Disk space bars" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Used-space bars on the Disk Space tab change colour as a drive fills up."/>

                            <TextBlock x:Name="LblDiskNormal" FontWeight="SemiBold" Margin="0,4,0,4"/>
                            <ctl:SwatchPicker x:Name="DiskNormalPicker" AllowAccent="True" Label="Disk normal colour" SelectedColorChanged="AnyChanged"/>

                            <Grid Margin="0,12,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LblDiskWarn" FontWeight="SemiBold" Style="{StaticResource FieldLabel}"/>
                                <Slider x:Name="SldDiskWarn" Grid.Column="1" Minimum="10" Maximum="98" TickFrequency="1"
                                        IsSnapToTickEnabled="True" ValueChanged="SliderChanged" VerticalAlignment="Center"
                                        AutomationProperties.Name="Disk warning threshold percent"/>
                            </Grid>
                            <ctl:SwatchPicker x:Name="DiskWarnPicker" AllowAccent="True" Label="Disk warning colour" SelectedColorChanged="AnyChanged"/>

                            <Grid Margin="0,12,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LblDiskCrit" FontWeight="SemiBold" Style="{StaticResource FieldLabel}"/>
                                <Slider x:Name="SldDiskCrit" Grid.Column="1" Minimum="11" Maximum="99" TickFrequency="1"
                                        IsSnapToTickEnabled="True" ValueChanged="SliderChanged" VerticalAlignment="Center"
                                        AutomationProperties.Name="Disk critical threshold percent"/>
                            </Grid>
                            <ctl:SwatchPicker x:Name="DiskCritPicker" AllowAccent="True" Label="Disk critical colour" SelectedColorChanged="AnyChanged"/>

                            <TextBlock Text="Preview" FontWeight="SemiBold" Margin="0,14,0,6"/>
                            <StackPanel x:Name="DiskPreview"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Folder size bars" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource Hint}" Text="The % of parent bars in the Folder Sizes grid."/>

                            <TextBlock x:Name="LblFolderLow" FontWeight="SemiBold" Margin="0,4,0,4"/>
                            <ctl:SwatchPicker x:Name="FolderLowPicker" AllowAccent="True" Label="Folder small colour" SelectedColorChanged="AnyChanged"/>

                            <Grid Margin="0,12,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LblFolderMed" FontWeight="SemiBold" Style="{StaticResource FieldLabel}"/>
                                <Slider x:Name="SldFolderMed" Grid.Column="1" Minimum="5" Maximum="98" TickFrequency="1"
                                        IsSnapToTickEnabled="True" ValueChanged="SliderChanged" VerticalAlignment="Center"
                                        AutomationProperties.Name="Folder medium threshold percent"/>
                            </Grid>
                            <ctl:SwatchPicker x:Name="FolderMedPicker" AllowAccent="True" Label="Folder medium colour" SelectedColorChanged="AnyChanged"/>

                            <Grid Margin="0,12,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LblFolderHigh" FontWeight="SemiBold" Style="{StaticResource FieldLabel}"/>
                                <Slider x:Name="SldFolderHigh" Grid.Column="1" Minimum="6" Maximum="99" TickFrequency="1"
                                        IsSnapToTickEnabled="True" ValueChanged="SliderChanged" VerticalAlignment="Center"
                                        AutomationProperties.Name="Folder large threshold percent"/>
                            </Grid>
                            <ctl:SwatchPicker x:Name="FolderHighPicker" AllowAccent="True" Label="Folder large colour" SelectedColorChanged="AnyChanged"/>

                            <TextBlock Text="Preview" FontWeight="SemiBold" Margin="0,14,0,6"/>
                            <StackPanel x:Name="FolderPreview"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══════════ GENERAL ═══════════ -->
                <StackPanel x:Name="PageGeneral" Visibility="Collapsed">
                    <TextBlock Text="General" Style="{StaticResource PageTitle}"/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Scanning" Style="{StaticResource CardTitle}"/>
                            <CheckBox x:Name="ChkAutoScan" Content="Automatically scan folders I open that haven't been scanned yet"
                                      Checked="AnyChanged" Unchecked="AnyChanged"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="When off, unscanned folders list their subfolders and you press Scan to calculate sizes."/>
                            <CheckBox x:Name="ChkParallelScan" Content="Fast parallel scanning"
                                      Checked="AnyChanged" Unchecked="AnyChanged" Margin="0,6,0,0"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Reads several folders at once. Best for SSD/NVMe drives; turn off for old spinning hard disks or slow network shares."/>
                            <CheckBox x:Name="ChkReadOwners" Content="Read file and folder owners"
                                      Checked="AnyChanged" Unchecked="AnyChanged" Margin="0,6,0,0"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Needed for the 'Files by Owner' report and owner search. Turning it off makes scans faster."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Settings file" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="TxtSettingsPath" Style="{StaticResource Hint}"/>
                            <Button Content="Open folder" HorizontalAlignment="Left" Click="BtnOpenSettingsFolder_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ── Footer ── -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource Win11RibbonBrush}"
                BorderBrush="{DynamicResource Win11BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="Reset to defaults" Click="BtnResetAll_Click"
                        ToolTip="Restore every setting (follow Windows theme, accent and text size)"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="OK" Width="90" IsDefault="True" Style="{StaticResource Win11AccentButtonStyle}" Click="BtnOk_Click"/>
                    <Button Content="Cancel" Width="90" Margin="8,0,0,0" IsCancel="True"/>
                    <Button x:Name="BtnApply" Content="Apply" Width="90" Margin="8,0,0,0" Click="BtnApply_Click" IsEnabled="False"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
